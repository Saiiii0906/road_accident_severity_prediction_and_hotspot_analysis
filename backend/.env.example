# =================================================================
# Vantage Backend — Production Environment Configuration Template
# =================================================================

# Application Environment
ENVIRONMENT=production
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0

# Security & CORS
# NOTE: Replace placeholder domains below with your actual verified frontend domain(s).
# Wildcard '*' is strictly disallowed in production.
CORS_ORIGINS=https://vantage.example.com,https://vantage-frontend.pages.dev

# LLM Synthesis Provider (Google Gemini is the single required provider)
# NOTE: Replace placeholder with your real API key. Never commit real keys to Git.
LLM_PRIMARY_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60.0

# Student Artifact Paths (Defaults resolve inside container)
# STUDENT_A_MODEL_PATH=student_A/models/accident_severity_model.pkl
# STUDENT_B_HOTSPOT_PATH=data/output/hotspot_summary.csv
# STUDENT_C_RISK_PATH=student_C/gnn_risk_predictions.json

# Model Acquisition (Optional: used only if model volume is not pre-mounted)
# VANTAGE_MODEL_SOURCE_URL=https://storage.googleapis.com/.../accident_severity_model.pkl
# VANTAGE_MODEL_SHA256=your_verified_sha256_checksum_here
