# ==============================================================================
# Road Accident Severity Prediction & Hotspot Analysis - Backend Configuration
# ==============================================================================

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME="Road Accident Severity Prediction & Hotspot Analysis"
DEBUG=false

# CORS Configuration
# Comma-separated list or JSON array of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Geocoding & Routing Providers
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=RoadAccidentAnalysis/1.0
GEOCODING_CACHE_MAX_SIZE=512
GEOCODING_CACHE_TTL_SECONDS=3600.0

OSRM_BASE_URL=https://router.project-osrm.org

# Real Live Context Providers
OPEN_METEO_BASE_URL=https://api.open-meteo.com
TFL_BASE_URL=https://api.tfl.gov.uk
# Optional TfL API App Key (leave blank for unauthenticated rate-limited access)
TFL_APP_KEY=

# Google Gemini AI Integration (Required for Gemini Journey Synthesis & AI Infrastructure Reports)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=30.0
GEMINI_MAX_RETRIES=2
GEMINI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
GEMINI_CIRCUIT_BREAKER_RESET_TIMEOUT_SECONDS=60.0
